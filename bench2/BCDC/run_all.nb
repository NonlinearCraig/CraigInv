               RowBox[{"\"\<varSet\>\"", "->", 
                RowBox[{"{", 
                 RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], 
               ",", 
               RowBox[{"\"\<inv\>\"", "->", 
                RowBox[{"InvTemp", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], 
                  ",", "2"}], "]"}]}], ",", 
               RowBox[{"\"\<xBound\>\"", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "100"}], ",", "100"}], "}"}]}], ",", 
               RowBox[{"\"\<preList\>\"", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "x4"}], ",", "x4", ",", 
                  RowBox[{"1", "-", "x1"}], ",", 
                  RowBox[{"x1", "-", "1"}], ",", 
                  RowBox[{"1", "-", "x2"}], ",", 
                  RowBox[{"x2", "-", "1"}], ",", "x3"}], "}"}]}], ",", 
               RowBox[{"\"\<guard\>\"", "->", 
                RowBox[{"{", "1", "}"}]}], ",", 
               RowBox[{"\"\<branchCondList\>\"", "->", 
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{"x3", "-", "x1"}], "}"}], "}"}]}], ",", 
               RowBox[{"\"\<branchPxList\>\"", "->", 
                RowBox[{"{", 
