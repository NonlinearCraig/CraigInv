 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RunAllBenchmarks", "[", 
     RowBox[{"registry_List", ",", 
      RowBox[{"timeout_Integer", ":", "600"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"results", "=", 
         RowBox[{"{", "}"}]}], ",", "currentResult", ",", "i"}], "}"}], ",", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "registry", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{
          RowBox[{"currentResult", "=", 
           RowBox[{"RunSingleBenchmark", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"registry", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Name\>\"", "]"}], 
             ",", 
             RowBox[{
              RowBox[{"registry", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Builder\>\"", "]"}], 
             ",", "timeout"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"results", ",", "currentResult"}], "]"}], ";"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", 
        "\"\<\\n=======================================================\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<\|01f3c6 Final Benchmark Summary Report\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", 
        "\"\<=======================================================\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Display", " ", "the", " ", "result", " ", "nicely", " ", "using", 
         " ", "Grid"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"Grid", "[", 
         RowBox[{
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Values", "/@", "results"}], ",", 
            RowBox[{"Keys", "[", 
             RowBox[{"results", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"Frame", "->", "All"}], ",", 
          RowBox[{"Background", "->", 
           RowBox[{"{", 
            RowBox[{"None", ",", 
             RowBox[{"{", 
              RowBox[{"LightGray", ",", "None"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"Alignment", "->", "Left"}]}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "results", "]"}], ";"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Execute", " ", "the", " ", "batch", " ", "processing", " ", 
    RowBox[{"(", 
     RowBox[{"Timeout", " ", "set", " ", "to", " ", "600", "s"}], ")"}]}], 
   "*)"}]}], "\n", 
 RowBox[{
