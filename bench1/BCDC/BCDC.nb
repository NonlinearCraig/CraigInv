Cell[BoxData[{
 RowBox[{
  StyleBox["lyapunov", "Subsection"], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"varSet8", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"inv8", "=", 
   RowBox[{"invTemp", "[", 
    RowBox[{"varSet8", ",", "a", ",", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xBound8", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"preList8", "=", 
   RowBox[{"{", 
    RowBox[{"0.25", "-", 
     RowBox[{"x1", "^", "2"}], "-", 
     RowBox[{"x2", "^", "2"}], "-", 
     RowBox[{"x3", "^", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negPostList8", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "*", "x1"}], "-", 
     RowBox[{"2", "*", "x2"}], "-", 
     RowBox[{"2", "*", "x3"}], "-", 
     RowBox[{"x1", "^", "2"}], "-", 
     RowBox[{"x2", "^", "2"}], "-", 
     RowBox[{"x3", "^", "2"}], "+", 
     RowBox[{"x1", "*", "x2"}], "+", 
     RowBox[{"x1", "*", "x3"}], "+", 
     RowBox[{"x2", "*", "x3"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"guard8", "=", 
   RowBox[{"{", 
    RowBox[{"9", "-", 
     RowBox[{"x1", "^", "2"}], "-", 
     RowBox[{"x2", "^", "2"}], "-", 
     RowBox[{"x3", "^", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wideg8", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"epsilon8", "=", 
   RowBox[{"N", "[", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"px8", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", "-", 
      RowBox[{"0.1", "*", "x2"}]}], ",", 
     RowBox[{"x2", "-", 
      RowBox[{"0.1", "*", "x3"}]}], ",", 
     RowBox[{"x3", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "x1"}], "-", 
         RowBox[{"2", "*", "x2"}], "-", "x3", "+", 
         RowBox[{"x1", "^", "3"}]}], ")"}], "*", "0.1"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"posteriorCheck8", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"verbose8", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pararange8", "=", 
